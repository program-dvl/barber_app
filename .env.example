APP_NAME="ClipperDesk"
BRAND_PRODUCT_NAME="ClipperDesk"
BRAND_COMPANY_NAME="ClipperDesk"
BRAND_TAGLINE="Run the day. Grow the business."
BRAND_WEBSITE_URL="${APP_URL}"
BRAND_BOOKING_HOST="book.clipperdesk.com"
BRAND_SUPPORT_EMAIL=support@clipperdesk.com
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=larafast
# DB_USERNAME=root
# DB_PASSWORD=


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=database
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Safe host-machine default: verification messages are written to storage/logs.
# Use smtp + 127.0.0.1 only when a local Mailpit process is actually running.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
BRAND_EMAIL_LOGO_URL="https://clipperdesk.com/build/assets/clipperdesk-mark-CDKNGozz.svg"

# Business-account mail. Production should use MAIL_MAILER=ses and verified
# identities on the approved ClipperDesk domain. Security, account, and billing
# can share an address initially while retaining distinct display names.
ACCOUNT_MAIL_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
ACCOUNT_MAIL_FROM_NAME="ClipperDesk"
SECURITY_MAIL_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
SECURITY_MAIL_FROM_NAME="ClipperDesk Security"
BILLING_MAIL_FROM_ADDRESS="${MAIL_FROM_ADDRESS}"
BILLING_MAIL_FROM_NAME="ClipperDesk Billing"
ACCOUNT_MAIL_REPLY_TO_ADDRESS=
ACCOUNT_MAIL_REPLY_TO_NAME="ClipperDesk Support"
ACCOUNT_EMAIL_QUEUE=emails
# off, new_device, or always
ACCOUNT_LOGIN_ALERTS=new_device
ACCOUNT_LOGIN_HISTORY_DAYS=180

# Transactional communications (production values belong in secret management)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
COMMUNICATION_EMAIL_FROM="ClipperDesk <notifications@clipperdesk.local>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_WEBHOOK_AUTH_TOKEN=
TWILIO_TEST_ACCOUNT_SID=
TWILIO_TEST_AUTH_TOKEN=
TWILIO_TEST_SMS_FROM=+15005550006
TWILIO_SMS_FROM=

# fake (default), twilio_test, or live. Test mode does not deliver a real text.
# Live mode is blocked unless separately enabled.
COMMUNICATIONS_TRANSPORT_MODE=fake
COMMUNICATIONS_IMMEDIATE_EVENT_DISPATCH=true
COMMUNICATIONS_LIVE_SEND_ENABLED=false

# Replace the local sender only after the approved production domain is acquired
# and SPF, DKIM, DMARC, return-path, and provider verification are complete.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_SES_CONFIGURATION_SET=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Browser-safe publishable key (pk_test_... or pk_live_...).
STRIPE_KEY=
# Server-side key (sk_test_.../sk_live_..., or a restricted rk_... key with the documented permissions).
STRIPE_SECRET=
STRIPE_APPOINTMENT_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_CURRENCY=USD
# Optional when using --provision; set these only to adopt/verify existing Prices.
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_STARTER_MONTHLY_AMOUNT=5000
STRIPE_STARTER_ANNUAL_AMOUNT=50000
STRIPE_PRO_MONTHLY_AMOUNT=10000
STRIPE_PRO_ANNUAL_AMOUNT=100000
BILLING_TRIAL_DAYS=14
BILLING_GRACE_DAYS=7
BILLING_EXPORT_DAYS_AFTER_TERMINATION=30

OPENAI_KEY=
XAI_KEY=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/callback/google"

# Client email shares SES credentials and the approved account sender by default.
COMMUNICATIONS_EMAIL_TRANSPORT_MODE=ses
# SES_CLIENT_FROM_ADDRESS=notifications@your-verified-domain.example
# Client notification display names use the ClipperDesk platform brand.
AWS_SES_CLIENT_SNS_TOPIC_ARN=

# Approved USD capacity prices require verified mappings and deployment setup.
# Use billing:verify-capacity-rates US --provision; see docs/deployment/subscription-billing-stripe.md.
CAPACITY_BILLING_ENABLED=false
CAPACITY_US_APPROVED=true
CAPACITY_AUTOMATIC_TAX=false
# Separate paid-text gate: certify refunds/disputes before enabling.
CAPACITY_SMS_PURCHASES_ENABLED=false
CAPACITY_US_MONTHLY_BASE_PRICE_ID=
CAPACITY_US_MONTHLY_LOCATION_PRICE_ID=
CAPACITY_US_MONTHLY_STAFF_PRICE_ID=
CAPACITY_US_ANNUAL_BASE_PRICE_ID=
CAPACITY_US_ANNUAL_LOCATION_PRICE_ID=
CAPACITY_US_ANNUAL_STAFF_PRICE_ID=

# Public booking URL. Development example: BOOKING_HOST=book.barber_app.test
# (with local DNS and HTTPS), or BOOKING_HOST=book.localhost:8000 / http.
BOOKING_HOST=book.clipperdesk.com
BOOKING_SCHEME=https

# Approved USD pricing is independent of the business operating currency.
CAPACITY_PRICING_MODE=usd

# Privacy notice publication. Identity defaults were supplied by the business owner.
# Set approval flags only after completing docs/audits/2026-10-12-privacy-policy/README.md.
# LEGAL_OPERATOR_NAME=Clipperdesk
# LEGAL_OPERATOR_ADDRESS="111 Galileo Dr, Stoney Creek, ON L8E 0B5, Canada"
# LEGAL_PRIVACY_EMAIL=support@clipperdesk.com
LEGAL_PRIVACY_APPROVED=false
LEGAL_PRIVACY_OPERATIONS_VERIFIED=false
LEGAL_PRIVACY_APPROVAL_REFERENCE=
LEGAL_PRIVACY_EFFECTIVE_DATE=
LEGAL_PROCESSING_COUNTRIES=
LEGAL_HOSTING_PROVIDER=
LEGAL_STORAGE_PROVIDER=
LEGAL_ACCOUNT_EMAIL_PROVIDER=
LEGAL_CLIENT_EMAIL_PROVIDER=
LEGAL_SMS_PROVIDER=
LEGAL_MONITORING_PROVIDER=

# Public browser key only. Restrict HTTP referrers and APIs; use separate keys per environment.
VITE_GOOGLE_MAPS_API_KEY=
# Use your own Google Cloud map ID in staging/production. DEMO_MAP_ID is a local fallback.
VITE_GOOGLE_MAPS_MAP_ID=
